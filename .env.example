NODE_ENV=development
PORT=5001
HOST=127.0.0.1
# Required in production; use the public origin without a trailing path.
APP_BASE_URL=http://127.0.0.1:5001

DATABASE_URL=
# "memory" is for local development only; production must use "database".
CRITICAL_DATA_PERSISTENCE=memory

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

OPENAI_API_KEY=

AMADEUS_ENV=production
AMADEUS_API_KEY_TEST=
AMADEUS_API_SECRET_TEST=
AMADEUS_API_KEY_LIVE=
AMADEUS_API_SECRET_LIVE=

AVIASALES_PARTNER_ID=
# Public Booking.com Affiliate Partner ID (aid); configure only after approval.
VITE_BOOKING_AFFILIATE_ID=

ZAPIER_WEBHOOK_URL=

PRINTFUL_API_KEY=
PRINTFUL_CONFIRM_ORDERS=false
PRINTFUL_WEBHOOK_SECRET=

# Keep this set to "test" until the seller identity, legal review and Stripe
# account are ready. Accepted values: disabled, test, live.
MERCHANDISE_SALES_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public seller details displayed in the legal pages. They become mandatory
# when MERCHANDISE_SALES_MODE=live. Do not insert placeholders in production.
VITE_SELLER_LEGAL_NAME=
VITE_SELLER_CONTACT_EMAIL=
VITE_SELLER_LEGAL_ADDRESS=
VITE_SELLER_COUNTRY=Italy
# Optional until a tax adviser confirms the correct business setup.
VITE_SELLER_VAT_ID=

# Transactional order emails. "disabled" never sends; "test" redirects every
# message to the test recipient; "live" sends to the verified Stripe customer.
TRANSACTIONAL_EMAIL_MODE=disabled
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=ByeBi <orders@updates.byebi.it>
TRANSACTIONAL_EMAIL_REPLY_TO=
TRANSACTIONAL_EMAIL_TEST_RECIPIENT=
